<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.12.0.0</Version>
    <AssemblyName>Sidekick</AssemblyName>
    <RootNamespace>Sidekick</RootNamespace>
    <Name>Sidekick</Name>
    <Author>Jago</Author>
    <RepoUrl>https://github.com/JagoIsReal/sidekick</RepoUrl>
    <Punchline>Your personal FFXIV toolbox.</Punchline>
    <Description>A personal toolbox for FFXIV. Open with /sidekick or /sk.</Description>
    <IconUrl>https://www.aht.li/3997968/icon.png</IconUrl>
    <Tags>utility;chat;highlight;mentions;focus;roleplay;cpose;penumbra;glamourer</Tags>
    <DalamudApiLevel>15</DalamudApiLevel>
    <MinimumDalamudVersion>15.0.3.9</MinimumDalamudVersion>
    <!-- Native UI state must be acquired/released on the framework thread. -->
    <LoadSync>true</LoadSync>
    <CanUnloadAsync>false</CanUnloadAsync>
    <ApplicableVersion>any</ApplicableVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../icon.png" Link="images/icon.png" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>

